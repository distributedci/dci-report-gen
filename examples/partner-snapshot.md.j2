{# ═══════════════════════════════════════════════════════════════════ #}
{# DCI Partner Snapshot — one page per partner team                     #}
{# Reporting week = [week_start, date_end) · baseline = 12 previous wks #}
{# Rates are `none` (rendered "n/a") when there is nothing to divide by. #}
{# ═══════════════════════════════════════════════════════════════════ #}
<style>
@page { size: A4; margin: 10mm 12mm; }
body { font-size: 8.5pt; line-height: 1.25; }
h1 { font-size: 15pt; margin: 0 0 2mm 0; padding-bottom: 1mm; }
h2 { font-size: 11pt; margin: 3mm 0 1mm 0; }
p, ul { margin: 1mm 0; }
li { margin: 0; }
table { margin: 1mm 0 2mm 0; font-size: 8pt; }
thead th { padding: 1mm 1.5mm; }
tbody td { padding: 0.8mm 1.5mm; }
svg { max-height: 62mm; }
</style>

{# ── Helpers ───────────────────────────────────────────────────────── #}
{% set min_jobs = (min_jobs | default(5)) | int %}
{% macro ratio(n, d) -%}{{ ((n / d * 100) | round(1)) ~ '%' if d else 'n/a' }}{%- endmacro %}
{% macro fmt_rate(r) -%}{{ (r | round(1)) ~ '%' if r is not none else 'n/a' }}{%- endmacro %}
{% macro light(ok, fin) -%}
{%- if not fin %}—{% elif ok / fin >= 0.8 %}🟢{% elif ok / fin >= 0.5 %}🟡{% else %}🔴{% endif -%}
{%- endmacro %}
{% macro delta(cur, ref, unit='', digits=0) -%}
{%- set d = cur - ref -%}
{%- if d > 0 %}▲ +{{ d | round(digits) | int if digits == 0 else d | round(digits) }}{{ unit }}
{%- elif d < 0 %}▼ {{ d | round(digits) | int if digits == 0 else d | round(digits) }}{{ unit }}
{%- else %}= {{ unit and ('0' ~ unit) or '0' }}{% endif -%}
{%- endmacro %}
{% macro short_ver(v) -%}
{%- if '-0.nightly-' in v %}{{ v.split('-0.nightly-')[0] }} nightly {{ v.split('-0.nightly-')[1][5:10] }}{% else %}{{ v }}{% endif -%}
{%- endmacro %}
{% macro status_counts(buckets) -%}
{%- set s = namespace(success=0, failure=0, error=0, killed=0, other=0) -%}
{%- for b in buckets -%}
{%- if b.key == 'success' %}{% set s.success = b.doc_count -%}
{%- elif b.key == 'failure' %}{% set s.failure = b.doc_count -%}
{%- elif b.key == 'error' %}{% set s.error = b.doc_count -%}
{%- elif b.key == 'killed' %}{% set s.killed = b.doc_count -%}
{%- else %}{% set s.other = s.other + b.doc_count %}{% endif -%}
{%- endfor -%}
{{ s.success }},{{ s.failure }},{{ s.error }},{{ s.killed }},{{ s.other }}
{%- endmacro %}
{% macro tc_counts(buckets) -%}
{%- set s = namespace(success=0, failure=0, skipped=0) -%}
{%- for b in buckets -%}
{%- if b.key == 'success' %}{% set s.success = s.success + b.doc_count -%}
{%- elif b.key in ['failure', 'error'] %}{% set s.failure = s.failure + b.doc_count -%}
{%- else %}{% set s.skipped = s.skipped + b.doc_count %}{% endif -%}
{%- endfor -%}
{{ s.success }},{{ s.failure }},{{ s.skipped }}
{%- endmacro %}

{# ── Weekly series (13 weeks, last one = reporting week) ───────────── #}
{% set rows = [] %}
{% for w in trend[0].weeks.buckets %}
{% set c = status_counts(w.st.buckets).split(',') | map('int') | list %}
{% set t = tc_counts(w.t.na.s.c.act.buckets).split(',') | map('int') | list %}
{% set fin = c[0] + c[1] + c[2] %}
{% set _ = rows.append({
    "label": w.key_as_string | iso_week("W{week:02d}"),
    "monday": w.key_as_string[:10],
    "jobs": w.doc_count,
    "success": c[0], "failure": c[1], "error": c[2], "killed": c[3], "other": c[4],
    "finished": fin,
    "rate": ((c[0] / fin * 100) | round(1)) if fin else none,
    "hours": ((w.dur.value or 0) / 3600) | round(0) | int,
    "tc_ok": t[0], "tc_ko": t[1], "tc_skip": t[2],
    "tc_rate": ((t[0] / (t[0] + t[1]) * 100) | round(1)) if (t[0] + t[1]) else none,
}) %}
{% endfor %}
{% set cur = rows[-1] if rows else none %}
{% set base = rows[:-1] %}
{% set nb = base | length %}

{# ── Baseline (12 previous weeks) averages ─────────────────────────── #}
{% set b = namespace(jobs=0, success=0, fin=0, hours=0, tc_ok=0, tc_ko=0, tc=0) %}
{% for r in base %}
{% set b.jobs = b.jobs + r.jobs %}{% set b.success = b.success + r.success %}
{% set b.fin = b.fin + r.finished %}{% set b.hours = b.hours + r.hours %}
{% set b.tc_ok = b.tc_ok + r.tc_ok %}{% set b.tc_ko = b.tc_ko + r.tc_ko %}
{% set b.tc = b.tc + r.tc_ok + r.tc_ko + r.tc_skip %}
{% endfor %}
{% set avg_jobs = (b.jobs / nb) if nb else 0 %}
{% set avg_hours = (b.hours / nb) if nb else 0 %}
{% set avg_tc = (b.tc / nb) if nb else 0 %}
{% set base_rate = (b.success / b.fin * 100) if b.fin else none %}
{% set base_tc_rate = (b.tc_ok / (b.tc_ok + b.tc_ko) * 100) if (b.tc_ok + b.tc_ko) else none %}

{# ── Reporting week KPIs ───────────────────────────────────────────── #}
{% set k = week_kpi[0] %}
{% set c = status_counts(k.by_status.buckets).split(',') | map('int') | list %}
{% set jobs = k.by_status.buckets | sum(attribute='doc_count') %}
{% set fin = c[0] + c[1] + c[2] %}
{% set rate = (c[0] / fin * 100) if fin else none %}
{% set hours = ((k.dur.value or 0) / 3600) | round(0) | int %}
{% set tst = week_tests[0].t.na %}
{% set tc = tc_counts(tst.s.c.act.buckets).split(',') | map('int') | list %}
{% set tc_total = tc[0] + tc[1] + tc[2] %}
{% set tc_rate = (tc[0] / (tc[0] + tc[1]) * 100) if (tc[0] + tc[1]) else none %}
{% set low_volume = fin < min_jobs %}

{# ── Weather ───────────────────────────────────────────────────────── #}
{% if jobs == 0 %}{% set weather = "⚪ No activity" %}
{% elif rate is none %}{% set weather = "⏳ No finished job" %}
{% elif rate >= 80 %}{% set weather = "🟢 Healthy" %}
{% elif rate >= 50 %}{% set weather = "🟡 Watch" %}
{% else %}{% set weather = "🔴 At risk" %}{% endif %}
{% if low_volume and rate is not none %}{% set weather = weather ~ " (low volume)" %}{% endif %}

# 📄 {{ partner or team }} — DCI Weekly Snapshot

{% if not team %}
> ⚠️ **No DCI team set** — pass `--var team=<DCI team name>`.
{% endif %}

**Team:** `{{ team }}` · **Week:** {{ cur.label if cur else '' }} ({{ week_start }} → {{ date_end }}, excl.) ·
**Remotecis:** {{ k.rcs.n.value }} · **Pipelines:** {{ k.pipes.n.value }} · **Status:** **{{ weather }}** ·
{% if journal_url %}[📓 Activity journal]({{ journal_url }}) · {% endif %}_Generated {{ date }}_

