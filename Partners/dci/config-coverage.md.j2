{% set matrix = namespace(items=[]) -%}
{%- for combo in combos -%}
  {%- set sub = tagged | selectattr('combo', 'equalto', combo) | rejectattr('status', 'equalto', 'running') | list -%}
  {%- set done = sub | length -%}
  {%- if done > 0 -%}
    {%- set ok = sub | selectattr('status', 'equalto', 'success') | list | length -%}
    {%- set bad = done - ok -%}
    {%- set sr = (ok / done * 100) | round(0) | int -%}
    {%- set _ = matrix.items.append({'combo': combo, 'done': done, 'ok': ok, 'bad': bad, 'sr': sr}) -%}
  {%- endif -%}
{%- endfor %}
