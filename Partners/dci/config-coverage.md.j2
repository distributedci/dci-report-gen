{# DCI Install Config Coverage & Heatmaps — MkDocs (Material) + Mermaid  #}
{# Scope: daily OCP install jobs (dci-openshift-agent)                   #}
{# ═══════════════════════════════════════════════════════════════════ #}

{# ── Build an enriched row list from raw hits ──────────────────────── #}
{%- set data = namespace(rows=[]) -%}
{%- for j in jobs -%}
  {%- set v = namespace(plat='n/a', topo='n/a', net='n/a', ip='n/a') -%}
  {%- for t in j.tags or [] -%}
    {%- if t.startswith('platform:') %}{% set v.plat = t[9:] %}
    {%- elif t.startswith('topology:') %}{% set v.topo = t[9:] %}
    {%- elif t.startswith('network_type:') %}{% set v.net = t[13:] %}
    {%- elif t.startswith('ip_stack:') %}{% set v.ip = t[9:] %}
    {%- endif -%}
  {%- endfor -%}
  {%- set kv = namespace(nc='', nw='', nm='', ncp='') -%}
  {%- for k in j.keys_values or [] -%}
    {%- if k.key == 'node_count' %}{% set kv.nc = k.value|int %}
    {%- elif k.key == 'nodes_worker' %}{% set kv.nw = k.value|int %}
    {%- elif k.key == 'nodes_master' %}{% set kv.nm = k.value|int %}
    {%- elif k.key == 'nodes_control-plane' %}{% set kv.ncp = k.value|int %}
    {%- endif -%}
  {%- endfor -%}
  {%- set has_tags = (v.plat != 'n/a') or (v.topo != 'n/a') or (v.net != 'n/a') or (v.ip != 'n/a') -%}
  {%- set has_kv = (kv.nc != '') -%}
  {%- set _ = data.rows.append({
      'id': j.id, 'name': j.name, 'status': j.status,
      'rci': j['remoteci.name'] or '—', 'topic': j['topic.name'] or '—',
      'plat': v.plat, 'topo': v.topo, 'net': v.net, 'ip': v.ip,
      'nc': kv.nc, 'nw': kv.nw, 'nm': kv.nm, 'ncp': kv.ncp,
      'has_tags': has_tags, 'has_kv': has_kv,
      'combo': v.plat ~ ' / ' ~ v.topo ~ ' / ' ~ v.net ~ ' / ' ~ v.ip
    }) -%}
{%- endfor -%}

{%- set rows = data.rows -%}
{%- set total = rows | length -%}

{# ── Coverage helper (emoji by pct) ────────────────────────────────── #}
{%- macro heat(pct) -%}
{%- if pct >= 90 %}🟩{% elif pct >= 60 %}🟨{% elif pct > 0 %}🟧{% else %}🟥{% endif -%}
{%- endmacro -%}

{# ── Global coverage counts ────────────────────────────────────────── #}
{%- set cov = namespace(tags=0, kv=0) -%}
{%- for r in rows -%}
  {%- if r.has_tags %}{% set cov.tags = cov.tags + 1 %}{% endif -%}
  {%- if r.has_kv %}{% set cov.kv = cov.kv + 1 %}{% endif -%}
{%- endfor -%}
{%- set cov_tags_pct = ((cov.tags / total * 100) | round(1)) if total > 0 else 0 -%}
{%- set cov_kv_pct = ((cov.kv / total * 100) | round(1)) if total > 0 else 0 -%}

{# ── Status counts ─────────────────────────────────────────────────── #}
{%- set st = namespace(success=0, failure=0, error=0, killed=0, running=0, other=0) -%}
{%- for r in rows -%}
  {%- if r.status == 'success' %}{% set st.success = st.success + 1 %}
  {%- elif r.status == 'failure' %}{% set st.failure = st.failure + 1 %}
  {%- elif r.status == 'error' %}{% set st.error = st.error + 1 %}
  {%- elif r.status == 'killed' %}{% set st.killed = st.killed + 1 %}
  {%- elif r.status == 'running' %}{% set st.running = st.running + 1 %}
  {%- else %}{% set st.other = st.other + 1 %}{% endif -%}
{%- endfor -%}

